
NODE_ENV=development
PORT=3000
# json (padrão) | pretty
LOG_FORMAT=json

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=wagering
DB_USER=wagering_app
DB_PASSWORD=dev_password_change_me
DB_POOL_MAX=10
DB_LOCK_TIMEOUT_MS=5000
DB_DEBUG=false

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_ENDPOINT=http://localhost:4566
# Entrada (WagerTransactionRequested) e sua DLQ — nomes exigidos pelo desafio
SQS_COMMAND_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_COMMAND_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
# Eventos de integração publicados pela outbox
SQS_EVENT_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# Consumer
SQS_CONSUMER_ENABLED=true
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_WAIT_TIME_SECONDS=20
SQS_RETRY_BASE_DELAY_SECONDS=2

# Outbox publisher
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=300000

# Reprocessamento de PENDING_REFERENCE (~5 min no total com os valores padrão)
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=50
PENDING_REFERENCE_BASE_DELAY_MS=1000
PENDING_REFERENCE_MAX_DELAY_MS=60000
PENDING_REFERENCE_MAX_ATTEMPTS=10
